rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Games collection - secure rules for multiplayer hangman
    match /games/{gameId} {
      // Allow read access to anyone (needed for joining games)
      allow read: if true;
      
      // Allow write access only to authenticated users
      allow write: if request.auth != null;
      
      // Allow create for authenticated users with proper game structure
      allow create: if request.auth != null 
        && request.resource.data.status in ['lobby', 'in-progress', 'complete']
        && request.resource.data.players is map;
      
      // Allow updates for authenticated users
      allow update: if request.auth != null;
      
      // Allow delete for authenticated users (admin functions)
      allow delete: if request.auth != null;
    }
    
    // Block all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
