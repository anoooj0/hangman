rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Games collection - secure rules for multiplayer hangman
    match /games/{gameId} {
      // Allow read access to anyone (needed for joining games)
      allow read: if true;
      
      // Allow write access only to authenticated users
      allow write: if request.auth != null;
      
      // Additional security: only allow specific fields
      allow create: if request.auth != null 
        && request.resource.data.keys().hasAll(['gameId', 'hostId', 'hostName', 'status', 'players', 'createdAt', 'lastActivity'])
        && request.resource.data.status in ['lobby', 'in-progress', 'complete']
        && request.resource.data.players is map
        && request.resource.data.players[request.auth.uid] != null;
      
      // Allow updates only for game participants
      allow update: if request.auth != null 
        && (request.auth.uid in resource.data.players.keys() 
            || request.auth.uid == resource.data.hostId);
      
      // Allow delete only for game host
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.hostId;
    }
    
    // Admin collection - only accessible to specific admin users
    match /admin/{document} {
      allow read, write: if request.auth != null 
        && request.auth.uid in ['YOUR_ADMIN_UID_HERE']; // Replace with your actual UID
    }
    
    // Block all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
